# Copy to .env and fill in. Never commit .env.

# PingOne region TLD: com (North America), eu, asia, ca, com.au
PINGONE_REGION=https://auth.pingone.sg

# PingOne environment that holds your users
PINGONE_ENV_ID=8ffdf2fe-9e4e-45be-ae14-6777276bbbd9

# Worker application (Admin console > Applications > Worker, token endpoint auth: Client Secret Post)
PINGONE_CLIENT_ID=06ff88ff-94af-4b1d-a813-11abee684fd7
PINGONE_CLIENT_SECRET=AJggD_sXOjxk4SkSOrBrBFkv3WDpcbbtZWPRmfsFSHvTph0lJ75P6T2WeJ9c7LWR

# Population new users are created in (Directory > Populations)
PINGONE_POPULATION_ID=dc290434-f043-4cf5-9213-ce0f124f1ee7

# Long random string used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

PORT=3000
