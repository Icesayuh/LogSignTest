# Seals the session and account cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- PingOne Directory (leave PINGONE_ENV_ID empty to use the built-in cookie demo store) ---

# Region of your PingOne tenant: com (North America), eu, asia, ca, com.au
PINGONE_REGION=

# Environment that holds your users (Admin console > Environment > Settings)
PINGONE_ENV_ID=

# Worker application (Admin console > Applications > Add Application > Worker).
# Token endpoint authentication method: Client Secret Basic.
# Give it a role that can create/read users and validate passwords (e.g. Identity Data Admin).
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# Population new users are created in (Directory > Populations)
PINGONE_POPULATION_ID=

# --- MFA on the page, through PingOne's MFA API ---
# On by default whenever PingOne is configured. Set to false to sign in with the password only.
PINGONE_MFA_ENABLED=

# Optional: ID of the device authentication policy to use (Authentication > MFA > Policies).
# Leave empty to use the environment's default MFA policy.
PINGONE_MFA_POLICY_ID=

# Optional: the methods offered when someone sets up MFA, from TOTP (authenticator app), EMAIL,
# FIDO2 (passkey) and SMS. Leave empty to offer whatever the MFA policy has enabled.
PINGONE_MFA_METHODS=

# --- PingOne Recognize (Keyless Web SDK): face registration at sign-up, face check at sign-in ---
# Runs after the password and the MFA code. Leave KEYLESS_CUSTOMER_NAME empty to switch it off.

# Needed at install time only (npm install), to download the SDK from Cloudsmith: the console's
# Download Key. Also add it in Vercel so the build can install the SDK.
CLOUDSMITH_TOKEN=

# Recognize console > the tenant's URL table. Copy the full URLs; the console shortens long ones with "…".
KEYLESS_CUSTOMER_NAME=
# "Authentication Service URL" (for the Web SDK), e.g. https://authentication-service-sandbox.eks.core-production.keyless.technology
KEYLESS_AUTHENTICATION_SERVICE_URL=
# "Operations Service URL": where the tenant's public signing keys are published, used to verify the result.
KEYLESS_OPERATIONS_SERVICE_URL=

# Set to false to turn the face check off while keeping the settings above.
KEYLESS_ENABLED=

# Optional. The PingOne user attribute (Boolean) that records a face is registered. Create it under
# Directory > Attributes > Add Attribute (Custom). Default: keylessEnrolled
PINGONE_RECOGNIZE_ATTRIBUTE=

# Optional, recommended: "User Authorization", which pins each face session to the user this server chose.
# Generate a key:  openssl genrsa -out keyless-user-auth.pem 2048
# Paste it here with newlines written as \n. Then ask Keyless to set the tenant's User Authorization to
# RemoteJWKSet with the JWKS URI https://<your-site>/.well-known/jwks.json (only Keyless can change that setting).
KEYLESS_USER_AUTH_PRIVATE_KEY=

# Optional checks on the signed result (leave empty unless Keyless gives you the values).
KEYLESS_JWT_ISSUER=
KEYLESS_JWT_TD_CLAIM=
