# Seals the session and account cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- PingOne Directory (leave PINGONE_ENV_ID empty to use the built-in cookie demo store) ---

# Region of your PingOne tenant: com (North America), eu, asia, ca, com.au
PINGONE_REGION=

# Environment that holds your users (Admin console > Environment > Settings)
PINGONE_ENV_ID=

# Worker application (Admin console > Applications > Add Application > Worker).
# Token endpoint authentication method: Client Secret Basic.
# Give it a role that can create/read users and validate passwords (e.g. Identity Data Admin).
PINGONE_CLIENT_ID=
PINGONE_CLIENT_SECRET=

# Population new users are created in (Directory > Populations)
PINGONE_POPULATION_ID=

# --- MFA on the page, through PingOne's MFA API ---
# On by default whenever PingOne is configured. Set to false to sign in with the password only.
PINGONE_MFA_ENABLED=

# Optional: ID of the device authentication policy to use (Authentication > MFA > Policies).
# Leave empty to use the environment's default MFA policy.
PINGONE_MFA_POLICY_ID=

# Optional: the methods offered when someone sets up MFA, from TOTP (authenticator app), EMAIL,
# FIDO2 (passkey) and SMS. Leave empty to offer whatever the MFA policy has enabled.
PINGONE_MFA_METHODS=

# --- PingOne Recognize (Keyless face biometrics): enrollment when registering, authentication when signing in ---
# On whenever RECOGNIZE_CUSTOMER_NAME is set. Set RECOGNIZE_ENABLED=false to skip the face step.
# Order of the flow: password -> face (Recognize) -> MFA (PingOne MFA, if enabled).

# Your tenant/customer name, as given by Ping/Keyless (the docs call it CUSTOMER_NAME)
RECOGNIZE_CUSTOMER_NAME=

# Keyless Authentication Service URL (the docs call it KEYLESS_AUTHENTICATION_SERVICE_URL; the SDK's ws-url)
RECOGNIZE_SERVICE_URL=

# Operation Service URL for your region, used to fetch the tenant JWKS that signs SDK results, e.g. https://api.keyless.io
RECOGNIZE_OPERATION_URL=

# RSA private key (PEM, newlines as \n) that signs the user-authorization tokens. Generate one with:
#   openssl genrsa -out recognize.pem 2048
# This app publishes the matching public key at /.well-known/jwks.json; give Keyless that URL as the
# "User Authorization JWKs URI" and ask them to set the User Authorization Type to RemoteJWKSet.
RECOGNIZE_SIGNING_KEY=
RECOGNIZE_SIGNING_KID=logsigntest-1

# Optional: require this "iss" on the JWT the SDK returns
RECOGNIZE_ISSUER=

# Install-time only (not read by the app): the console's "Download Key" is the Cloudsmith token for .npmrc.
#   export CLOUDSMITH_TOKEN=...   then   npm install
