# PingOne Recognize Web SDK packages come from the Cloudsmith repository.
# Set CLOUDSMITH_TOKEN (the "Download Key" token from the Recognize console) before running npm install,
# locally and in Vercel (Project > Settings > Environment Variables).
@keyless:registry=https://npm.cloudsmith.io/keyless/partners/
//npm.cloudsmith.io/keyless/partners/:_authToken=${CLOUDSMITH_TOKEN}
